NODE_ENV=development
PORT=3000
# El nombre de base se toma de esta URL. Codificar caracteres especiales de la clave.
DB_URL=mysql://pizzeria_app:CAMBIAR_CLAVE@localhost:3306/pizzeria
# Opcional. Si se define, debe coincidir con el nombre de DB_URL.
DB_NAME=pizzeria
# false: aplicar el esquema explícitamente con pnpm run db:update.
# En producción nunca se ejecuta la sincronización automática.
DB_SYNC_SCHEMA=false
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
COSTO_ENVIO=1500
# Solo para importar una vez las imágenes antiguas de uploads/pizzas a MySQL.
IMPORTAR_IMAGENES_LOCALES=false

# Mercado Pago: esta implementación admite exclusivamente pruebas.
# Para checkout/webhook, FRONTEND_URL y BACKEND_URL deben ser URLs públicas HTTPS.
MP_MODO=prueba
MP_ACCESS_TOKEN=REEMPLAZAR_POR_TOKEN_DEL_VENDEDOR_DE_PRUEBA
MP_VENDEDOR_PRUEBA_ID=REEMPLAZAR_POR_ID_DEL_VENDEDOR_DE_PRUEBA
MP_WEBHOOK_SECRET=REEMPLAZAR_POR_SECRETO_DE_FIRMA_DEL_WEBHOOK
