@baseUrl = http://localhost:3000

### Login como admin (todas las rutas de /api/repartidores exigen admin: verificarToken + requiereNivel(1))
# @name loginAdmin
POST {{baseUrl}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "admin@test.com",
  "contrasenia": "admin123"
}

###

@tokenAdmin = {{loginAdmin.response.body.$.data.token}}

### Obtener todos los repartidores (Devuelve la lista completa de la BD)
GET {{baseUrl}}/api/repartidores HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Crear un nuevo repartidor. Obligatorios: nombre, apellido, email, contrasenia (mínimo 8
### caracteres), nivel_permisos (0 o 1), estado, matricula. monto_propina_total es opcional
### (default 0).
# @name crearRepartidor
POST {{baseUrl}}/api/repartidores HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "email": "juan.perez@mail.com",
  "contrasenia": "clave123",
  "nivel_permisos": 0,
  "estado": true,
  "matricula": "MOT-1234"
}

###

@repartidorCreadoId = {{crearRepartidor.response.body.$.data.id}}

### Probar validación estricta: un campo extra ahora se RECHAZA (debería devolver 400,
### "Unrecognized key"), ya no se ignora silenciosamente como con el viejo middleware de sanitización.
POST {{baseUrl}}/api/repartidores HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "María",
  "apellido": "Gómez",
  "email": "maria.gomez@mail.com",
  "contrasenia": "clave456",
  "nivel_permisos": 1,
  "estado": true,
  "matricula": "MOT-5678",
  "monto_propina_total": 0,
  "propiedadInyectada": "hack",
  "idFalso": 9999
}

###

### Probar validación: contraseña demasiado corta (debería devolver 400, mínimo 8 caracteres)
POST {{baseUrl}}/api/repartidores HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Corto",
  "apellido": "Password",
  "email": "corto@mail.com",
  "contrasenia": "1234567",
  "nivel_permisos": 0,
  "estado": true,
  "matricula": "MOT-0000"
}

###

### Obtener un repartidor por ID (usá el id devuelto por el POST de arriba)
GET {{baseUrl}}/api/repartidores/{{repartidorCreadoId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Modificar un repartidor por ID (nivel_permisos y monto_propina_total NO son modificables
### por este endpoint: el schema los omite a propósito)
PUT {{baseUrl}}/api/repartidores/{{repartidorCreadoId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "estado": false
}

###

### Modificar: intentar cambiar nivel_permisos por PUT (debería devolver 400, "Unrecognized key")
PUT {{baseUrl}}/api/repartidores/{{repartidorCreadoId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nivel_permisos": 1
}

###

### Modificar: objeto vacío (debería devolver 400, "Debe enviar al menos un campo para actualizar")
PUT {{baseUrl}}/api/repartidores/{{repartidorCreadoId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{}

###

### Eliminar un repartidor por ID
DELETE {{baseUrl}}/api/repartidores/{{repartidorCreadoId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}
