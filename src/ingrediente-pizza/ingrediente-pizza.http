@baseUrl = http://localhost:3000

### Login como admin (todas las rutas de /api/ingrediente-pizza exigen admin: verificarToken + requiereNivel(1))
# @name loginAdmin
POST {{baseUrl}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "admin@test.com",
  "contrasenia": "admin123"
}

###

@tokenAdmin = {{loginAdmin.response.body.$.data.token}}

### Crear una pizza de prueba primero (necesaria para el ingrediente-pizza)
# @name crearPizza
POST {{baseUrl}}/api/pizzas HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Napolitana",
  "precio": 4500,
  "vegetariana": false,
  "disponible": true
}

###

@pizzaDePruebaId = {{crearPizza.response.body.$.data.id}}

### Crear un ingrediente de prueba (necesario para el ingrediente-pizza)
# @name crearIngrediente
POST {{baseUrl}}/api/ingredientes HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Queso Muzzarella",
  "stock": 100
}

###

@ingredienteDePruebaId = {{crearIngrediente.response.body.$.data.id}}

### Obtener todos los ingredientes de pizza
GET {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Crear un ingrediente-pizza (usa los ids reales creados arriba). cantidad debe ser > 0.
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 200,
  "pizzaId": {{pizzaDePruebaId}},
  "ingredienteId": {{ingredienteDePruebaId}}
}

###

### Probar validación: pizzaId inexistente (debería devolver 404)
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 100,
  "pizzaId": 999999,
  "ingredienteId": {{ingredienteDePruebaId}}
}

###

### Probar validación: ingredienteId inexistente (debería devolver 404)
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 100,
  "pizzaId": {{pizzaDePruebaId}},
  "ingredienteId": 999999
}

###

### Probar validación: la pareja pizza+ingrediente ya existe (debería devolver 409; corré el bloque de "crear" de arriba antes)
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 50,
  "pizzaId": {{pizzaDePruebaId}},
  "ingredienteId": {{ingredienteDePruebaId}}
}

###

### Probar validación: cantidad <= 0 (debería devolver 400)
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 0,
  "pizzaId": {{pizzaDePruebaId}},
  "ingredienteId": {{ingredienteDePruebaId}}
}

###

### Probar validación estricta: campo extra no permitido (debería devolver 400, "Unrecognized key")
POST {{baseUrl}}/api/ingrediente-pizza HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 100,
  "pizzaId": {{pizzaDePruebaId}},
  "ingredienteId": {{ingredienteDePruebaId}},
  "notas": "extra queso"
}

###

### Obtener un ingrediente-pizza por su clave compuesta (pizzaId/ingredienteId), incluye pizza
### e ingrediente poblados. OJO: la clave es compuesta, no es un único "id".
GET {{baseUrl}}/api/ingrediente-pizza/{{pizzaDePruebaId}}/{{ingredienteDePruebaId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Obtener la composición completa de una pizza (todos sus ingredientes)
GET {{baseUrl}}/api/ingrediente-pizza/pizza/{{pizzaDePruebaId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Modificar la cantidad de un ingrediente-pizza (el PUT solo acepta "cantidad"; cualquier
### otro campo, incluido pizzaId/ingredienteId, se rechaza por ser un schema estricto con pick)
PUT {{baseUrl}}/api/ingrediente-pizza/{{pizzaDePruebaId}}/{{ingredienteDePruebaId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 250
}

###

### Modificar: campo no permitido en el PUT (debería devolver 400, "Unrecognized key")
PUT {{baseUrl}}/api/ingrediente-pizza/{{pizzaDePruebaId}}/{{ingredienteDePruebaId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "cantidad": 250,
  "pizzaId": {{pizzaDePruebaId}}
}

###

### Eliminar un ingrediente-pizza por su clave compuesta
DELETE {{baseUrl}}/api/ingrediente-pizza/{{pizzaDePruebaId}}/{{ingredienteDePruebaId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

### Limpieza: borrar la pizza y el ingrediente de prueba creados arriba
DELETE {{baseUrl}}/api/pizzas/{{pizzaDePruebaId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}

###

DELETE {{baseUrl}}/api/ingredientes/{{ingredienteDePruebaId}} HTTP/1.1
Authorization: Bearer {{tokenAdmin}}
