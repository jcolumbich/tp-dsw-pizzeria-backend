{
  "name": "tp-dsw-pizzeria-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p ./tsconfig.json",
    "start": "node ./dist/server.js",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/server.js\"",
    "test": "pnpm run build && node scripts/test.mjs all",
    "test:watch": "pnpm run build && node scripts/test.mjs unit --watchAll",
    "test:unit": "pnpm run build && node scripts/test.mjs unit",
    "test:integration": "pnpm run build && node scripts/test.mjs integration",
    "db:preview": "pnpm run build && node dist/shared/db/schema.js",
    "db:update": "pnpm run build && node dist/shared/db/schema.js --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@mikro-orm/cli": "^5.9.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "tsc-watch": "6.0.4",
    "tsx": "^4.23.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mikro-orm/core": "^5.9.8",
    "@mikro-orm/mysql": "^5.9.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0"
  }
}
