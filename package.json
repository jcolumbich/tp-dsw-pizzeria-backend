{
  "name": "Tp Github",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p ./tsconfig.json",
    "start": "node ./dist/app.js",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "test": "tsc --build tsconfig.json --force && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "tsc --build tsconfig.json --force && node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@mikro-orm/cli": "^5.9.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "26.1.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "tsc-watch": "6.0.4",
    "tsx": "^4.23.11",
    "typescript": "5.1.3"
  },
  "dependencies": {
    "@mikro-orm/core": "^5.9.8",
    "@mikro-orm/mysql": "^5.9.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}